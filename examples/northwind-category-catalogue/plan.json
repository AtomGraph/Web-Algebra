[
  {
    "@op": "Variable",
    "args": {
      "name": "catalogue",
      "value": {
        "@op": "Filter",
        "args": {
          "input": {
            "@op": "Filter",
            "args": {
              "input": {
                "@op": "ldh-CreateContainer",
                "args": {
                  "parent": {
                    "@id": "https://localhost:4443/"
                  },
                  "title": "Northwind product catalogue",
                  "slug": "northwind-category-catalogue",
                  "description": "Product categories of Northwind Traders, with their products."
                }
              },
              "expression": 1
            }
          },
          "expression": "url"
        }
      }
    }
  },
  {
    "@op": "ldh-AddGenericService",
    "args": {
      "url": {
        "@op": "Value",
        "args": {
          "name": "$catalogue"
        }
      },
      "endpoint": {
        "@id": "https://northwind-traders.demo.linkeddatahub.com/sparql"
      },
      "title": "Northwind Traders",
      "fragment": "northwind"
    }
  },
  {
    "@op": "ForEach",
    "args": {
      "select": {
        "@op": "SELECT",
        "args": {
          "endpoint": {
            "@id": "https://northwind-traders.demo.linkeddatahub.com/sparql"
          },
          "query": "PREFIX schema: <https://schema.org/> PREFIX foaf: <http://xmlns.com/foaf/0.1/> SELECT ?category ?id ?name ?description ?image WHERE { GRAPH ?g { ?category a schema:ProductGroup ; schema:identifier ?id ; schema:name ?name ; schema:description ?description ; foaf:depiction ?image } } ORDER BY ?id"
        }
      },
      "operation": [
        {
          "@op": "Variable",
          "args": {
            "name": "item",
            "value": {
              "@op": "Filter",
              "args": {
                "input": {
                  "@op": "Filter",
                  "args": {
                    "input": {
                      "@op": "ldh-CreateItem",
                      "args": {
                        "container": {
                          "@op": "Value",
                          "args": {
                            "name": "$catalogue"
                          }
                        },
                        "title": {
                          "@op": "Value",
                          "args": {
                            "name": "name"
                          }
                        },
                        "slug": {
                          "@op": "Str",
                          "args": {
                            "input": {
                              "@op": "Value",
                              "args": {
                                "name": "id"
                              }
                            }
                          }
                        }
                      }
                    },
                    "expression": 1
                  }
                },
                "expression": "url"
              }
            }
          }
        },
        {
          "@op": "ldh-AddXHTMLBlock",
          "args": {
            "url": {
              "@op": "Value",
              "args": {
                "name": "$item"
              }
            },
            "value": {
              "@op": "Concat",
              "args": {
                "inputs": [
                  "<div xmlns=\"http://www.w3.org/1999/xhtml\">",
                  "<p>",
                  {
                    "@op": "Value",
                    "args": {
                      "name": "description"
                    }
                  },
                  "</p>",
                  "</div>"
                ]
              }
            }
          }
        },
        {
          "@op": "ldh-AddObjectBlock",
          "args": {
            "url": {
              "@op": "Value",
              "args": {
                "name": "$item"
              }
            },
            "value": {
              "@op": "Value",
              "args": {
                "name": "image"
              }
            }
          }
        },
        {
          "@op": "ldh-AddSelect",
          "args": {
            "url": {
              "@op": "Value",
              "args": {
                "name": "$item"
              }
            },
            "title": {
              "@op": "Concat",
              "args": {
                "inputs": [
                  "Products in ",
                  {
                    "@op": "Value",
                    "args": {
                      "name": "name"
                    }
                  }
                ]
              }
            },
            "fragment": "products-query",
            "service": {
              "@op": "ResolveURI",
              "args": {
                "base": {
                  "@op": "Value",
                  "args": {
                    "name": "$catalogue"
                  }
                },
                "relative": "#northwind"
              }
            },
            "query": {
              "@op": "Substitute",
              "args": {
                "query": "PREFIX schema: <https://schema.org/> SELECT ?product WHERE { GRAPH ?g { ?product schema:category ?category ; schema:name ?name } } ORDER BY ?name",
                "var": "category",
                "binding": {
                  "@op": "Value",
                  "args": {
                    "name": "category"
                  }
                }
              }
            }
          }
        },
        {
          "@op": "ldh-AddView",
          "args": {
            "url": {
              "@op": "Value",
              "args": {
                "name": "$item"
              }
            },
            "query": {
              "@op": "ResolveURI",
              "args": {
                "base": {
                  "@op": "Value",
                  "args": {
                    "name": "$item"
                  }
                },
                "relative": "#products-query"
              }
            },
            "title": {
              "@op": "Concat",
              "args": {
                "inputs": [
                  "Products in ",
                  {
                    "@op": "Value",
                    "args": {
                      "name": "name"
                    }
                  }
                ]
              }
            },
            "fragment": "products",
            "mode": {
              "@id": "https://w3id.org/atomgraph/client#ListMode"
            }
          }
        },
        {
          "@op": "ldh-AddObjectBlock",
          "args": {
            "url": {
              "@op": "Value",
              "args": {
                "name": "$item"
              }
            },
            "value": {
              "@op": "ResolveURI",
              "args": {
                "base": {
                  "@op": "Value",
                  "args": {
                    "name": "$item"
                  }
                },
                "relative": "#products"
              }
            }
          }
        }
      ]
    }
  }
]
